# LIFE.EXE server configuration.
# Copy this file to `.env` for local development. On Netlify, set these under
# Site configuration → Environment variables. Never commit a real key.

# Your Anthropic API key (https://console.anthropic.com/). Leave empty to run in DEMO MODE.
AI_API_KEY=

# Optional: which Claude model to use. Defaults to claude-opus-5.
# AI_MODEL=claude-opus-5

# Optional: how much thinking the model does before answering: low | medium | high.
# Higher is slower. Defaults to low, which keeps answers fast enough for Netlify's function time limit.
# AI_EFFORT=low
