# LIFE.EXE — environment configuration
#
# Nothing here is required to run the app. Without these, LIFE.EXE runs
# entirely in DEMO MODE: the agent reasoning engine (lib/agent/engine.ts) is a
# transparent, deterministic heuristic pipeline, and web research
# (lib/research/service.ts) returns clearly-labeled illustrative results.
#
# LIFE.EXE ships as a static export (no server), so SEARCH_API_KEY only does
# anything if you also add back a server route around lib/research/service.ts
# (see README → "Research is a clean seam"). Until then it's unreachable by
# design — a static site has nowhere to keep a secret.

# Optional: enables live web research once wired behind a server route.
# Without it, ScamSense-adjacent "current info" questions fall back to a
# labeled demo research layer instead of pretending to search the web.
SEARCH_API_KEY=
SEARCH_API_URL=

# Optional: reserved for wiring a real model (e.g. the Anthropic Messages API)
# into lib/agent/engine.ts in place of the heuristic classifier/strategy
# generator. Not read anywhere yet — the heuristic engine needs no key.
AI_API_KEY=
