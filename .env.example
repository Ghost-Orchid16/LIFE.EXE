# LIFE.EXE — environment configuration
#
# Nothing here is required to run the app. Without these, LIFE.EXE runs
# entirely in DEMO MODE: the agent reasoning engine (lib/agent/engine.ts) is a
# transparent, deterministic heuristic pipeline, and web research
# (lib/research/service.ts) returns clearly-labeled illustrative results.
#
# All three integration points are isolated server-side seams (lib/agent/gemini.ts,
# lib/research/service.ts) — nothing below is ever exposed to the browser.

# Optional: a Google AI Studio (Gemini) API key — https://aistudio.google.com/apikey
# When set, app/api/agent/route.ts routes situations through lib/agent/gemini.ts
# for real model reasoning instead of the heuristic engine. If the call ever
# fails (bad key, timeout, rate limit), the route falls back to the
# deterministic heuristic engine automatically — the app never breaks because
# of this key.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.5-flash).
GEMINI_MODEL=

# Optional: enables live web research in /api/research.
# Without it, "current info" questions fall back to a labeled demo research
# layer instead of pretending to search the web.
SEARCH_API_KEY=
SEARCH_API_URL=

# Optional: reserved for a different model provider (e.g. the Anthropic
# Messages API) if you'd rather wire that in instead of Gemini. Not read
# anywhere yet.
AI_API_KEY=
