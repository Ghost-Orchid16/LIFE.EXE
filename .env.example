# LIFE.EXE server configuration.
# Copy this file to `.env` for local development. On Netlify, set these in the
# project's environment variables. These are read on the server only; never commit a real key.

# Your Google Gemini API key (create one at https://aistudio.google.com/apikey).
# Leave empty to run in DEMO MODE.
GEMINI_API_KEY=

# Optional: which Gemini model to use. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
